{
  "name": "dordaneh-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "دُردانه — بازی معمای کلمات فارسی روزانه (مونوریپو ۱۵ AI)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "qa"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\" \"qa/src/**/*.ts\" \"tools/**/*.mjs\"",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"qa/src/**/*.ts\"",
    "check:ownership": "node tools/check-ownership.mjs",
    "check:budget": "node tools/check-budget.mjs",
    "build:app": "npm run build -w @dordaneh/app-shell",
    "cap:sync": "npm run build:app && npx cap sync android"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.8.0",
    "@typescript-eslint/parser": "8.8.0",
    "eslint": "9.11.1",
    "prettier": "3.3.3",
    "typescript": "5.6.2",
    "vite": "5.4.8",
    "vitest": "2.1.2",
    "@vitest/coverage-v8": "2.1.2"
  }
}
